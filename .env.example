# ---------------------------------------------------------------------------
# SUSHI platform environment. Copy to .env.local and fill in.
# Never commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the server. For Supabase use the
# "Session pooler" or direct connection string (Project Settings -> Database).
# Local dev default (npm run db:start):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/sushi
# Set to "true" for hosted databases that require TLS (Supabase does).
DATABASE_SSL=false

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site URL (used for payment return URLs and callbacks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Storage (optional; without it uploads go to ./public/uploads) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Without Supabase, production stores uploads in PostgreSQL (served from /media).
# Set STORAGE_PROVIDER=db to do the same in development.
STORAGE_PROVIDER=

# --- SMS OTP ---------------------------------------------------------------
# "console"  logs codes to the server output and is refused in production.
# "telegram" sends the code via the Telegram bot to the chat linked to the phone
#            (customers share their number with the bot once). Free; works in production.
# "eskiz"    uses Eskiz.uz (adapter not implemented yet).
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Payments --------------------------------------------------------------
# Comma-separated list of enabled methods: cash,card_on_delivery,click,payme,mock
# "mock" is a local simulator and is always refused when NODE_ENV=production.
PAYMENT_METHODS=cash,card_on_delivery,click,payme,mock

# Click SHOP API (merchant cabinet -> Services)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# Payme Merchant API (merchant cabinet -> Cashbox)
PAYME_MERCHANT_ID=
PAYME_KEY=
# checkout.test.paycom.uz for the sandbox, checkout.paycom.uz for production
PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz

# --- Maps / address lookup -------------------------------------------------
# "local" uses the built-in Tashkent gazetteer. "yandex" needs a key.
GEOCODER_PROVIDER=local
YANDEX_GEOCODER_KEY=

# --- Courier dispatch (optional) --------------------------------------------
# "in_house" means your own couriers; no external API calls.
COURIER_PROVIDER=in_house

# --- Telegram bot (npm run bot) ---------------------------------------------
# Create a bot with @BotFather. Staff connect from /admin/telegram; customers
# share their phone in the bot. Run exactly one `npm run bot` worker.
# TELEGRAM_MODE=webhook runs the bot inside the web server instead of the worker
# (for hosts without background workers, e.g. Render free). Needs a public https site URL.
# Tip: use a separate test bot token locally once the real bot runs in production.
TELEGRAM_MODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: extra chat ids (comma-separated) that receive the full admin feed
# read-only, e.g. the owner's chat or a group. Send /id to the bot to see yours.
TELEGRAM_ADMIN_CHAT_IDS=
