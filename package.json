{
  "name": "sushi-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:render": "tsx scripts/migrate.ts && next start",
    "lint": "tsc --noEmit",
    "db:start": "node scripts/local-db.mjs",
    "bot": "tsx scripts/bot.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-customer.mjs && node scripts/e2e-admin.mjs",
    "e2e:realtime": "tsx scripts/e2e-realtime.ts",
    "shots": "node scripts/shots.mjs && node scripts/shots-mobile.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20"
  }
}
